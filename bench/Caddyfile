# Caddy (Go's crypto/tls) as k3 is compared with it: the same page, key and certificate,
# TLS 1.3 only with X25519, nothing logged.
{
	auto_https off
	admin off
}
:443 {
	tls /etc/nginx/k3bench/server.pem /etc/nginx/k3bench/server.key {
		protocols tls1.3
		curves x25519
	}
	root * /var/www/k3bench
	file_server
}
:80 {
	root * /var/www/k3bench
	file_server
}
